{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artsonia-connector",
  "main": "src/worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Artsonia is stateless — only the per-session MCP agent Durable Object is
  // declared (no local cache, so no cache DO like the OFW connector has).
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "ArtsoniaMcpAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArtsoniaMcpAgent"] }],
  // artsonia-connector's own OAuth token store (title: artsonia-connector-oauth).
  // Kept separate from any other connector's OAUTH_KV so their OAuth grants/tokens
  // never cross-wire. To stand up a fresh deployment, create your own
  // (wrangler kv namespace create artsonia-connector-oauth) and replace this id.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "210a86624567481ba67949e176a0cc5e" }],
  // Production custom domain (matches ofw-mcp's connector.ofw.nullnet.app and
  // zola-mcp's connector.zola.nullnet.app). The zone must be in the deploying
  // account's Cloudflare; wrangler provisions the hostname on deploy. Remove this
  // route to deploy to *.workers.dev only.
  "routes": [{ "pattern": "connector.artsonia.nullnet.app", "custom_domain": true }],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
